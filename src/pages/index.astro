---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import Marquee from '../components/Marquee.astro';
import Escalations from '../components/Escalations.astro';
import About from '../components/About.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Approach from '../components/Approach.astro';
import Numbers from '../components/Numbers.astro';
import Experience from '../components/Experience.astro';
import MoreWork from '../components/MoreWork.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import WorkModal from '../components/WorkModal.astro';
---

<BaseLayout>
  <Navbar />

  <main id="main-content">
    <Hero />
    <Statement />
    <Marquee />
    <Escalations />
    <About />
    <SelectedWork />
    <Approach />
    <Numbers />
    <Experience />
    <MoreWork />
    <Contact />
  </main>

  <Footer />
  <WorkModal />
</BaseLayout>
