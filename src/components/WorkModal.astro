---
---
<div id="work-modal" class="work-modal no-print" hidden aria-hidden="true">
  <div class="work-modal__veil" aria-hidden="true"></div>
  <div class="work-modal__shell" role="dialog" aria-modal="true" aria-labelledby="work-modal-live-title" tabindex="-1">
    <header class="work-modal__chrome">
      <p class="label work-modal__count">
        <span id="work-modal-index">01</span>
        <span class="work-modal__count-sep" aria-hidden="true">/</span>
        <span id="work-modal-total">00</span>
      </p>
      <p class="label work-modal__hint hidden md:block">Scroll to browse</p>
      <button type="button" class="work-modal__close" data-close aria-label="Close">
        <span aria-hidden="true">&times;</span>
      </button>
    </header>
    <div class="work-modal__track" id="work-modal-track" tabindex="0"></div>
    <p id="work-modal-live-title" class="sr-only" aria-live="polite"></p>
  </div>
</div>
