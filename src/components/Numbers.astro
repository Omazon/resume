---
---
<section class="section hairline" aria-labelledby="numbers-heading">
  <div class="max-w-[1400px] mx-auto px-6 md:px-10">
    <h2 id="numbers-heading" class="sr-only">Key numbers</h2>
    <div class="numbers">
      <div data-reveal>
        <p class="number__value"><span data-count="3">3</span> <em>mo</em></p>
        <p class="label mt-3">To rescue a year-late product</p>
      </div>
      <div data-reveal data-delay="0.05">
        <p class="number__value"><span data-count="2017" data-from="1990">2017</span></p>
        <p class="label mt-3">Shipping since</p>
      </div>
      <div data-reveal data-delay="0.1">
        <p class="number__value">F<em>→A</em></p>
        <p class="label mt-3">Diagnosed performance grade</p>
      </div>
      <div data-reveal data-delay="0.15">
        <p class="number__value"><span data-count="90" data-from="40">90</span><em>→<span data-count="20" data-from="60">20</span></em></p>
        <p class="label mt-3">Minutes to optimize</p>
      </div>
      <div data-reveal data-delay="0.2">
        <p class="number__value"><em>+</em><span data-count="30" data-suffix="%">30%</span></p>
        <p class="label mt-3">Lead volume increase</p>
      </div>
      <div data-reveal data-delay="0.25">
        <p class="number__value">C2</p>
        <p class="label mt-3">EF SET English</p>
      </div>
    </div>
  </div>
</section>
