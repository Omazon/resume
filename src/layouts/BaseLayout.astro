---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Omar Boza - Senior Web Developer & Tech Lead | Webflow, WordPress, React, Next.js | AI Automation',
  description = "Omar Boza — the developer teams escalate to for feasibility calls, WordPress mysteries, and hard delivery. Webflow, WordPress, PHP, JavaScript, React, Next.js. Ships with agentic AI for US clients. EF SET C2 English.",
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      dateModified: '2026-09-12',
      mainEntity: { '@id': 'https://omazon.github.io/resume/#person' },
    },
    {
      '@type': 'Person',
      '@id': 'https://omazon.github.io/resume/#person',
      name: 'Omar Boza',
      jobTitle: 'Senior Web Developer | Tech Lead | Webflow, WordPress, React, Next.js',
      description:
        'The developer teams escalate to for feasibility calls, WordPress root-cause, and hard delivery. Also builds full-stack products with React, Next.js, TypeScript, Tailwind CSS, and PostgreSQL. Ships faster with agentic AI for US clients. EF SET C2 English.',
      email: 'omarboza@gmail.com',
      telephone: '+50583992586',
      url: 'https://omazon.github.io/resume/',
      image: 'https://omazon.github.io/resume/assets/img/about.png',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Managua',
        addressCountry: 'NI',
      },
      sameAs: [
        'https://www.linkedin.com/in/omar-boza/',
        'https://github.com/Omazon',
        'https://www.instagram.com/ing.omarboza/',
      ],
      knowsAbout: [
        'Webflow', 'WordPress', 'Custom Theme And Plugin Development', 'WordPress Architecture', 'Git', 'AI-Assisted Development', 'PHP', 'Laravel', 'CSS', 'JavaScript',
        'Client-First', 'AI Automation', 'n8n', 'MCP', 'Cursor', 'Claude Code',
        'React', 'Vue', 'Next.js', 'TypeScript', 'Tailwind CSS', 'PostgreSQL', 'Node.js', 'HTML',
        'REST APIs', 'Vercel', 'Playwright',
        'Elementor', 'Bricks', 'Gutenberg', 'Advanced Custom Fields', 'WooCommerce', 'Shopify site administration', 'SEO', 'Core Web Vitals', 'GTmetrix', 'RAG', 'HIPAA',
      ],
      knowsLanguage: [
        { '@type': 'Language', name: 'English', alternateName: 'en' },
        { '@type': 'Language', name: 'Spanish', alternateName: 'es' },
      ],
      hasCredential: {
        '@type': 'EducationalOccupationalCredential',
        name: 'EF SET English Certificate',
        credentialCategory: 'certificate',
        competencyRequired: 'C2 Proficient',
        dateCreated: '2026-08-29',
        url: 'https://cert.efset.org/B6TnCM',
      },
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'National Engineering University',
      },
    },
    {
      '@type': 'OrganizationRole',
      roleName: 'Web Developer',
      startDate: '2024-01',
      endDate: '2026-08',
      worksFor: { '@type': 'Organization', name: 'Your Digital Resource' },
    },
    {
      '@type': 'OrganizationRole',
      roleName: 'Software Engineer',
      startDate: '2022',
      endDate: '2024',
      worksFor: { '@type': 'Organization', name: 'Nicasource' },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
